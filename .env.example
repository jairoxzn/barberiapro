# ==============================================================
#  BarberiaPro - Ejemplo de variables de entorno
#  Copia este archivo a .env y completa los valores reales.
# ==============================================================

NODE_ENV=development
PORT=4000

# --- Base de datos (Neon PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"

# --- JWT (genera secretos largos y aleatorios) ---
JWT_ACCESS_SECRET="genera-un-secreto-de-64+caracteres"
JWT_REFRESH_SECRET="genera-otro-secreto-distinto"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# --- CORS / Frontend ---
CORS_ORIGIN="http://localhost:5173"

# --- Uploads ---
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5

# --- Rate limit ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
